# MQTT broker used by the greenhouse producer.
GREENHOUSE_MQTT_HOST=192.168.8.132
GREENHOUSE_MQTT_PORT=1883
GREENHOUSE_MQTT_USER=
GREENHOUSE_MQTT_PASS=
GREENHOUSE_MQTT_BASE_TOPIC=greenhouse

# The producer historically emitted timestamps without an offset. Interpret
# those legacy values in this IANA time zone before storing them as timestamptz.
GREENHOUSE_SOURCE_TIMEZONE=America/Los_Angeles

# Local peer authentication maps the service's greenhouse OS user to the
# greenhouse PostgreSQL role, so no database password is stored here.
GREENHOUSE_DATABASE_DSN=dbname=greenhouse user=greenhouse host=/var/run/postgresql

# Materialize complete one-hour windows after this delay. Raw samples remain
# queryable until GREENHOUSE_RAW_RETENTION expires.
GREENHOUSE_COMPACT_AFTER=1 day
GREENHOUSE_RAW_RETENTION=30 days

# Delete hourly aggregates after this age. This must be greater than the raw
# retention interval.
GREENHOUSE_HOURLY_RETENTION=5 years

# Serve the newest optical_*.jpg at GET /. Tailscale Serve proxies this
# loopback listener as https://datastore.tail63be5a.ts.net/.
GREENHOUSE_IMAGE_API_HOST=127.0.0.1
GREENHOUSE_IMAGE_API_PORT=8080
GREENHOUSE_IMAGE_DIRECTORY=/mnt/datastore/greenhouse-captures

GREENHOUSE_LOG_LEVEL=INFO
[Unit]
Description=Greenhouse MQTT to TimescaleDB consumer
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=greenhouse
Group=greenhouse
EnvironmentFile=/etc/greenhouse-datastore/greenhouse-datastore.env
ExecStart=/opt/greenhouse-datastore/venv/bin/greenhouse-datastore
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=greenhouse-datastore
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
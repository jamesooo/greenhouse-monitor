[Unit]
Description=Greenhouse Monitor - BLE Climate and Optical Camera Monitoring
Documentation=https://github.com/your-repo/pysenxor
After=network-online.target remote-fs.target bluetooth.target
Wants=network-online.target bluetooth.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
# Root required for USB bind/unbind operations
# If running as non-root, ensure user has permissions for:
#   - /sys/bus/usb/drivers/usb/bind and unbind
#   - Video devices (/dev/video*)
#   - Bluetooth

# Environment file with all configuration
EnvironmentFile=/etc/greenhouse/greenhouse.env

# Working directory (for relative paths if needed)
WorkingDirectory=/opt/greenhouse

# The main command - uses the installed console script from the venv
ExecStart=/opt/greenhouse/venv/bin/greenhouse-monitor

# Restart configuration
Restart=on-failure
RestartSec=30

# Resource limits (optimized for Pi Zero 2 W)
# 256MB memory limit - adjust based on your needs
MemoryMax=256M
MemoryHigh=200M

# CPU quota - limit to 50% of one core to leave headroom
CPUQuota=50%

# Nice priority (lower priority than system tasks)
Nice=10

# I/O scheduling (best-effort, low priority)
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/greenhouse
ReadWritePaths=/opt/greenhouse/captures
ReadWritePaths=/greenhouse-captures

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=greenhouse-monitor

# Graceful shutdown timeout
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

# Greenhouse Monitor Configuration
# Copy this file to /etc/greenhouse/greenhouse.env
# and edit with your settings.
#
# This file is read by the systemd service.
# All values are optional - defaults will be used if not set.

# =============================================================================
# BLE Climate Sensors
# =============================================================================

# Comma-separated list of BLE MAC addresses for climate sensors
# Find addresses using: bluetoothctl scan on
# Example: AA:BB:CC:DD:EE:FF,11:22:33:44:55:66
GREENHOUSE_BLE_ADDRESSES=

# Polling interval in seconds (default: 60)
# Set to 0 to disable BLE monitoring
GREENHOUSE_BLE_INTERVAL=60

# =============================================================================
# Camera Configuration
# =============================================================================

# Metric collection interval in seconds (default: 300 = 5 minutes)
# Both optical and thermal cameras are read each cycle for light/canopy metrics
GREENHOUSE_CAMERA_INTERVAL=300

# Image save interval in seconds (default: 0 = same as camera interval)
# Set to -1 to disable image saving entirely (metrics only mode)
# Set to a higher value than camera interval to save images less frequently
# Example: camera_interval=60, image_capture_interval=3600 = metrics every minute, images hourly
GREENHOUSE_IMAGE_CAPTURE_INTERVAL=0

# USB device IDs for cameras
# Find these using: lsusb -t
# Format is like "1-1.1.4" (bus-port.port.port)
GREENHOUSE_OPTICAL_USB_ID=1-1.1.4
GREENHOUSE_THERMAL_USB_ID=1-1.1.3

# =============================================================================
# Output Configuration
# =============================================================================

# Directory for captured images
# Will be created if it doesn't exist
# Ensure the service has write permissions
GREENHOUSE_OUTPUT_DIR=/opt/greenhouse/captures

# =============================================================================
# MQTT Configuration
# =============================================================================

# MQTT broker address (required for data publishing)
# Leave empty to disable MQTT and only save images
GREENHOUSE_MQTT_HOST=

# MQTT broker port (default: 1883)
GREENHOUSE_MQTT_PORT=1883

# MQTT authentication (optional)
# Leave empty if broker doesn't require authentication
GREENHOUSE_MQTT_USER=
GREENHOUSE_MQTT_PASS=

# Base topic prefix (default: greenhouse)
# Topics will be:
#   {base}/climate/{MAC}  - BLE sensor readings
#   {base}/light          - Light metrics from optical camera
#   {base}/canopy         - Canopy temperature from thermal camera
GREENHOUSE_MQTT_BASE_TOPIC=greenhouse

# =============================================================================
# Debug Options
# =============================================================================

# Enable debug logging (true/false, default: false)
GREENHOUSE_DEBUG=false

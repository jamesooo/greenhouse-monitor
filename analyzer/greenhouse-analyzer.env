# Grafana must have image rendering configured. Use a service-account token when
# anonymous dashboard access is disabled.
GREENHOUSE_GRAFANA_URL=http://datastore:3000
GREENHOUSE_GRAFANA_DASHBOARD_UID=greenhouse-climate
GREENHOUSE_GRAFANA_DASHBOARD_SLUG=greenhouse-climate
GREENHOUSE_GRAFANA_TOKEN=
GREENHOUSE_GRAFANA_TIME_RANGE=now-24h
GREENHOUSE_GRAFANA_WIDTH=1600
GREENHOUSE_GRAFANA_HEIGHT=1200
GREENHOUSE_GRAFANA_TIMEZONE=browser

# The selected Ollama model must support both image input and tool calling for
# use by Deep Agents. Set this URL to the separately hosted Ollama API.
GREENHOUSE_OLLAMA_BASE_URL=http://ollama:11434
GREENHOUSE_OLLAMA_MODEL=qwen3-vl:8b
GREENHOUSE_OLLAMA_TEMPERATURE=0.1
GREENHOUSE_OLLAMA_NUM_PREDICT=700

GREENHOUSE_ANALYSIS_PROMPT_FILE=/etc/greenhouse-analyzer/prompt.txt
GREENHOUSE_ANALYSIS_REQUEST_TIMEOUT=120
GREENHOUSE_ANALYSIS_MAX_IMAGE_BYTES=10485760
GREENHOUSE_ANALYSIS_LOG_LEVEL=INFO

# Pelican content is retained here and rebuilt into the output directory after
# every analysis. SITE_URL may remain empty when serving from the domain root.
GREENHOUSE_SITE_CONTENT_DIRECTORY=/var/lib/greenhouse-analyzer/content
GREENHOUSE_SITE_OUTPUT_DIRECTORY=/var/lib/greenhouse-analyzer/output
GREENHOUSE_PELICAN_SETTINGS=/etc/greenhouse-analyzer/pelicanconf.py
GREENHOUSE_PELICAN_THEME=/opt/greenhouse-analyzer/site/theme
GREENHOUSE_SITE_NAME=Greenhouse Daily
GREENHOUSE_SITE_URL=
GREENHOUSE_SITE_TIMEZONE=America/Los_Angeles
GREENHOUSE_SITE_HOST=127.0.0.1
GREENHOUSE_SITE_PORT=8081
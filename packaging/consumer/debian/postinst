#!/bin/sh
set -e

INSTALL_DIR=/opt/greenhouse-datastore
SRC_DIR="$INSTALL_DIR/src"
VENV_DIR="$INSTALL_DIR/venv"
STATE_DIR=/var/lib/greenhouse-datastore

case "$1" in
    configure)
        if ! getent passwd greenhouse >/dev/null; then
            adduser --system --group --home "$STATE_DIR" --no-create-home greenhouse
        fi
        mkdir -p "$STATE_DIR"
        chown greenhouse:greenhouse "$STATE_DIR"
        chmod 750 "$STATE_DIR"
        chmod 600 /etc/greenhouse-datastore/greenhouse-datastore.env

        rm -rf "$VENV_DIR"
        python3 -m venv "$VENV_DIR"
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV_DIR/bin/pip" install \
            --requirement "$SRC_DIR/requirements.txt"
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV_DIR/bin/pip" install \
            --use-pep517 --no-deps "$SRC_DIR"

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable greenhouse-datastore.service >/dev/null
            systemctl restart greenhouse-datastore.service
            systemctl try-restart grafana-server.service >/dev/null 2>&1 || true
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
#!/bin/sh
set -e

case "$1" in
    remove)
        rm -rf /opt/greenhouse-analyzer/venv
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
    purge)
        rm -rf /opt/greenhouse-analyzer /var/lib/greenhouse-analyzer
        deluser --system greenhouse-analyzer >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
esac

exit 0
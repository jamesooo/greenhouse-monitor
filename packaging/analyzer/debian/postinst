#!/bin/sh
set -e

INSTALL_DIR=/opt/greenhouse-analyzer
SRC_DIR="$INSTALL_DIR/src"
VENV_DIR="$INSTALL_DIR/venv"
STATE_DIR=/var/lib/greenhouse-analyzer

case "$1" in
    configure)
        if ! getent passwd greenhouse-analyzer >/dev/null; then
            adduser --system --group --home "$STATE_DIR" --no-create-home greenhouse-analyzer
        fi
        mkdir -p "$STATE_DIR/content/images" "$STATE_DIR/output"
        chown -R greenhouse-analyzer:greenhouse-analyzer "$STATE_DIR"
        chmod 750 "$STATE_DIR"
        chown root:greenhouse-analyzer /etc/greenhouse-analyzer/greenhouse-analyzer.env
        chmod 640 /etc/greenhouse-analyzer/greenhouse-analyzer.env

        rm -rf "$VENV_DIR"
        python3 -m venv "$VENV_DIR"
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV_DIR/bin/pip" install \
            --requirement "$SRC_DIR/requirements.txt"
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV_DIR/bin/pip" install \
            --use-pep517 --no-deps "$SRC_DIR"

        runuser -u greenhouse-analyzer -- "$VENV_DIR/bin/python" -m pelican \
            "$STATE_DIR/content" \
            --settings /etc/greenhouse-analyzer/pelicanconf.py \
            --output "$STATE_DIR/output"

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable --now greenhouse-analyzer.timer >/dev/null
            systemctl enable greenhouse-analysis-site.service >/dev/null
            systemctl restart greenhouse-analysis-site.service
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
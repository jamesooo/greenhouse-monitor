#!/bin/sh
set -e

case "$1" in
    remove)
        rm -rf /opt/greenhouse/venv
        if [ -d /run/systemd/system ]; then
            systemctl disable greenhouse-monitor.service >/dev/null 2>&1 || true
            systemctl daemon-reload
        fi
        ;;
    purge)
        rm -rf /opt/greenhouse /etc/greenhouse /var/lib/greenhouse /var/log/greenhouse
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0

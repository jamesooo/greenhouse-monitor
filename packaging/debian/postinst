#!/bin/sh
set -e

INSTALL_DIR=/opt/greenhouse
SRC_DIR="$INSTALL_DIR/src"
VENV_DIR="$INSTALL_DIR/venv"

case "$1" in
    configure)
        chmod 600 /etc/greenhouse/greenhouse.env
        mkdir -p \
            "$INSTALL_DIR/captures" \
            /greenhouse-captures \
            /var/lib/greenhouse/captures \
            /var/log/greenhouse

        # Recreate the package-managed environment so removed dependencies do not
        # survive an upgrade from the former SenXor-enabled package.
        rm -rf "$VENV_DIR"
        python3 -m venv "$VENV_DIR"
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV_DIR/bin/pip" install \
            --requirement "$SRC_DIR/requirements.txt"
        PIP_DISABLE_PIP_VERSION_CHECK=1 "$VENV_DIR/bin/pip" install \
            --use-pep517 --no-deps "$SRC_DIR"

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            systemctl enable greenhouse-monitor.service >/dev/null
            systemctl restart greenhouse-monitor.service
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0

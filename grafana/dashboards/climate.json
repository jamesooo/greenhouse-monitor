          "rawQuery": true,
          "rawSql": "WITH series AS (SELECT observed_at AS time, main_temp AS value, sensor_address || ' main' AS metric FROM climate_readings WHERE main_temp IS NOT NULL UNION ALL SELECT observed_at, external_temp, sensor_address || ' external' FROM climate_readings WHERE external_temp IS NOT NULL UNION ALL SELECT bucket, main_temp_avg, sensor_address || ' main' FROM climate_readings_hourly WHERE main_temp_avg IS NOT NULL AND bucket < COALESCE((SELECT min(observed_at) FROM climate_readings), 'infinity'::timestamptz) UNION ALL SELECT bucket, external_temp_avg, sensor_address || ' external' FROM climate_readings_hourly WHERE external_temp_avg IS NOT NULL AND bucket < COALESCE((SELECT min(observed_at) FROM climate_readings), 'infinity'::timestamptz)) SELECT time, value, metric FROM series WHERE $__timeFilter(time) ORDER BY time",
          "refId": "A"
        }

[Unit]
Description=Capture images from optical and thermal USB cameras
After=network.target

[Service]
Type=oneshot
User=jamesooo
Group=jamesooo
WorkingDirectory=/home/jamesooo/pysenxor-master
ExecStart=/home/jamesooo/pysenxor-master/venv/bin/python -u /home/jamesooo/pysenxor-master/example/get_thermal_and_optical_capture_usbs.py --output-dir /home/jamesooo/captures
Environment="PATH=/home/jamesooo/pysenxor-master/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-capture

# Timeout for the capture process (2 minutes should be plenty)
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
